{
  "name": "obsidian-okf",
  "version": "0.1.0",
  "description": "Validate, author, and export your Obsidian vault as Open Knowledge Format (OKF) bundles.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "version": "node version-bump.mjs && git add manifest.json versions.json"
  },
  "keywords": [
    "obsidian",
    "okf",
    "open-knowledge-format",
    "knowledge",
    "ai",
    "agents",
    "export"
  ],
  "author": "Kenny G",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.11.0",
    "builtin-modules": "^3.3.0",
    "esbuild": "^0.20.0",
    "obsidian": "^1.5.7",
    "tslib": "^2.6.2",
    "typescript": "^5.3.3"
  }
}
